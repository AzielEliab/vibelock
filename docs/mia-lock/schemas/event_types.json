{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azieleliab.example/mia-lock/event_types.json",
  "title": "M.I.A.Lock Event Types",
  "description": "Event classes for missing-person discovery including archives, cold cases, and John/Jane Doe unidentified notices.",
  "version": "1.2.0",
  "definitions": {
    "event_class": {
      "type": "string",
      "enum": [
        "missing_person_notice",
        "missing_person_update",
        "unidentified_remains",
        "john_doe_notice",
        "jane_doe_notice",
        "cold_case_unidentified",
        "cold_case_missing",
        "found_person_notice",
        "arrest",
        "booking",
        "custody",
        "release",
        "incarceration",
        "warrant_public",
        "charge",
        "court_filing",
        "hearing",
        "disposition",
        "appeal",
        "crime_incident",
        "homicide_victim",
        "homicide_suspect_mention",
        "crime_victim_mention",
        "crime_witness_mention",
        "public_tip_or_release",
        "obituary",
        "death_notice",
        "funeral_notice",
        "archive_obituary",
        "vital_death_index",
        "medical_examiner_case",
        "news_missing_report",
        "news_crime_report",
        "news_identification",
        "newspaper_archive_hit",
        "historical_publication",
        "periodical_clipping",
        "library_digital_collection",
        "archive_missing_report",
        "archive_crime_report",
        "discovery_lead"
      ]
    },
    "subject_role": {
      "type": "string",
      "enum": [
        "missing",
        "victim",
        "suspect_mention",
        "witness_mention",
        "decedent",
        "unidentified",
        "unspecified"
      ]
    },
    "event_date_kind": {
      "type": "string",
      "enum": [
        "arrest",
        "booking",
        "filing",
        "hearing",
        "disposition",
        "publication",
        "death",
        "service",
        "last_seen",
        "reported_missing",
        "discovered",
        "estimated_death",
        "retrieval",
        "unknown"
      ]
    },
    "source_tier": {
      "type": "string",
      "enum": [
        "authoritative_public",
        "authorized_institutional",
        "independent_reporting",
        "death_remembrance",
        "archive",
        "discovery"
      ]
    },
    "search_mode": {
      "type": "string",
      "enum": ["active", "archives", "doe_cold", "cold_missing", "all"]
    }
  },
  "event_class_groups": {
    "missing_and_unidentified": [
      "missing_person_notice",
      "missing_person_update",
      "unidentified_remains",
      "john_doe_notice",
      "jane_doe_notice",
      "cold_case_unidentified",
      "cold_case_missing",
      "found_person_notice"
    ],
    "arrest_booking_custody": [
      "arrest",
      "booking",
      "custody",
      "release",
      "incarceration",
      "warrant_public"
    ],
    "courts": [
      "charge",
      "court_filing",
      "hearing",
      "disposition",
      "appeal"
    ],
    "crime_and_homicide": [
      "crime_incident",
      "homicide_victim",
      "homicide_suspect_mention",
      "crime_victim_mention",
      "crime_witness_mention",
      "public_tip_or_release"
    ],
    "death_and_obituary": [
      "obituary",
      "death_notice",
      "funeral_notice",
      "archive_obituary",
      "vital_death_index",
      "medical_examiner_case"
    ],
    "archives_and_publishing": [
      "newspaper_archive_hit",
      "historical_publication",
      "periodical_clipping",
      "library_digital_collection",
      "archive_missing_report",
      "archive_crime_report",
      "archive_obituary"
    ],
    "news_and_discovery": [
      "news_missing_report",
      "news_crime_report",
      "news_identification",
      "discovery_lead"
    ]
  },
  "mvp_required_event_classes": [
    "missing_person_notice",
    "booking",
    "court_filing",
    "obituary",
    "news_crime_report",
    "newspaper_archive_hit",
    "jane_doe_notice",
    "john_doe_notice",
    "unidentified_remains",
    "discovery_lead"
  ],
  "cold_case_required_event_classes": [
    "cold_case_missing",
    "cold_case_unidentified",
    "john_doe_notice",
    "jane_doe_notice",
    "unidentified_remains",
    "newspaper_archive_hit",
    "library_digital_collection",
    "archive_missing_report",
    "archive_crime_report"
  ]
}
